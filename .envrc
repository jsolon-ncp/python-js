# === GitHub Environment Auto-Switch ===
# Repo type: Work Personal (jsolon-ncp)

export GH_PROFILE="jsolon-ncp"
export GIT_SSH_COMMAND="ssh -i /Users/juansolon/.ssh/id_ed25519_work"

# Switch GH CLI profile
gh auth switch --user "$GH_PROFILE" >/dev/null 2>&1 ||     echo "⚠️ Could not switch GH profile to $GH_PROFILE"

eval "$(gh auth setup-git)"

# Check authentication
if ! gh auth status --user "$GH_PROFILE" >/dev/null 2>&1; then
  echo "⚠️  GitHub CLI not logged in for profile '$GH_PROFILE'."
  echo "👉  Run 'gh auth login --hostname github.com --git-protocol ssh' for this account."
else
  echo "✅ Active GitHub CLI profile: $GH_PROFILE"
fi
